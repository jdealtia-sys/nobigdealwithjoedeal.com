# Cloudflare Pages cache tuning — place at repo root (same level as index.html)
# Only content-hashed files get immutable; non-hashed assets stay at 1 day so
# deploys aren't fighting stale caches.

# Build-hashed inline scripts (filenames change on content change → safe forever)
/assets/js/inline/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font binaries (verify the path matches what nbd-fonts.css references)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: deliberately NOT extending nbd-fonts.css, nbd-mobile.css, nav-faq.js,
# ann-bar.js etc. — they aren't content-hashed, so max-age=86400 (current
# default) is the right call. If the build ever starts hashing them, move them
# into an immutable rule.
# IMPORTANT: this file must be named exactly `_headers` (no extension) at the
# repo root — stored in Drive as `_headers.txt` only so it keeps a text mime.