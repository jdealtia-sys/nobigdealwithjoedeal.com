rules_version = '2';

// NBD Pro Firestore Security Rules — HARDENED (2026-04-11)
// Deploy: firebase deploy --only firestore:rules
//
// Security model:
//   - Roles come from custom claims (`request.auth.token.role`), not from a
//     user-writable `users/{uid}.role` field.
//   - Broad `allow read: if isAuth()` is a footgun — every collection here
//     scopes reads to the resource owner, their company, or an admin.
//   - Subscription, rate_limits, access_codes, audit_log are admin-SDK-only.
//   - Public-write collections keep strict shape checks.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    //
    // Role taxonomy (custom claims):
    //   'admin'          → PLATFORM admin (support/ops). Cross-tenant.
    //                      Set only by a manual admin SDK script.
    //   'company_admin'  → tenant owner. Full access within own company.
    //   'manager'        → tenant manager. Read all team leads + reports.
    //   'sales_rep'      → individual rep. Owns their own docs only.
    //   'viewer'         → read-only inside their company.
    //
    // `isAdmin()` is now PLATFORM admin only — never use it on its own
    // for multi-tenant resources. Always pair it with
    // `sameCompanyAsResource()` or a company-scoped helper.
    function isAuth()    { return request.auth != null; }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function isAdmin()   { return isAuth() && request.auth.token.role == 'admin'; }
    function isCompanyAdmin() { return isAuth() && request.auth.token.role == 'company_admin'; }
    function isManager() { return isAuth() && request.auth.token.role == 'manager'; }

    function myCompanyId() {
      return request.auth.token.companyId;
    }

    function sameCompanyAsResource() {
      // CRITICAL: require BOTH sides to be non-null. A token without a
      // companyId claim would otherwise pass this check against any
      // legacy doc whose companyId field was never set.
      return isAuth()
        && request.auth.token.companyId != null
        && resource.data.companyId != null
        && resource.data.companyId == request.auth.token.companyId;
    }

    // Company admin / manager acting inside their own tenant. Use this
    // for "see any lead in my team" style rules — NOT isAdmin() alone.
    function isCompanyStaff() {
      return isCompanyAdmin() || isManager();
    }

    // Company-wide PIPELINE readers — the roles the product grants team
    // lead-visibility (role taxonomy above: manager sees all reps' leads,
    // viewer is read-only INSIDE their company). sales_rep is deliberately
    // absent: own-leads-only — the same decision the Wave-110 client
    // hydration filter enforces at the fetch layer so teammates' data
    // never reaches a rep's browser. Role read via .get(): solo operators
    // carry NO role claim and a bare token.role access THROWS (NEW-5).
    function isCompanyReader() {
      return isAuth()
        && request.auth.token.get('role', '') in ['company_admin', 'manager', 'viewer'];
    }

    // Field-diff helper used by users/<uid> to block privilege escalation.
    function didNotChange(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Parent-lead company check for lead SUBCOLLECTION reads: the caller
    // is a company reader (see isCompanyReader) and the PARENT lead
    // belongs to their tenant — so a manager opening a teammate's
    // customer page gets its activity/notes/documents, not a shell.
    // Fully throw-proof (.get() on BOTH sides): subcollection parents can
    // be legacy docs without companyId, and defensive tokens may lack the
    // claim. The get() is the same parent read the owner clause already
    // pays — rules dedupe repeated access to one document per request.
    function parentLeadInMyCompany(leadId) {
      return isCompanyReader()
        && request.auth.token.get('companyId', '') != ''
        && get(/databases/$(database)/documents/leads/$(leadId)).data.get('companyId', '')
             == request.auth.token.get('companyId', '');
    }

    // ── LEADS ─────────────────────────────────────────
    // companyId is required on create. The Rock 3 backfill
    // (PR #56 audit/backfill callable) stamped companyId on every
    // pre-existing lead, so the field is now an invariant — every
    // lead in /leads/{leadId} must carry the creator's tenant scope.
    // Enforcing it here closes the "stray lead with no companyId"
    // hole that would otherwise let team-scoped queries (managers,
    // leaderboard rollups) silently miss new records.
    //
    // Token-claim ownership match (companyId == myCompanyId()) is
    // intentionally NOT enforced yet — that's a follow-up after
    // verifying every active user's custom claims include companyId.
    match /leads/{leadId} {
      // Team pipeline visibility (2026-07-06) — the follow-up the comment
      // above promised, unblocked once provisioning/claimInvite guarantee
      // companyId claims (proven end-to-end by the Stranger Test).
      // company_admin/manager/viewer read every lead in THEIR tenant;
      // sales_rep stays own-only (isCompanyReader excludes it). Shape
      // mirrors /expenses exactly — the form the rules tests prove
      // query-compliant for where('companyId','==',claim) list queries.
      // Owner check stays FIRST: legacy docs without companyId remain
      // owner-readable (absent-key access in the company clause errors
      // to deny, never widens).
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // Audit #3 F-1: writes require a non-viewer role. A 'viewer' who happens
      // to own a lead can still READ it but can no longer mutate it at the rules
      // layer (read-only was previously UI-enforced only). Users with no role
      // claim (solo operators) keep write access.
      // NEW-5: use .get('role','') NOT `.role != 'viewer'`. Reading an ABSENT
      // map key with != THROWS in Firestore rules (it does not return undefined),
      // so a solo operator with no role claim — the intended-allowed case above —
      // was getting PERMISSION_DENIED on EVERY lead update/delete (soft-delete
      // silently failed; the optimistic-UI removal masked it, so deleted leads
      // reappeared on the next loadLeads, incl. bridged /inspect web-leads).
      // .get(key, default) returns the default when the key is absent and never
      // throws, preserving the viewer-only deny.
      allow update, delete: if (isOwner(resource.data.userId)
            && request.auth.token.get('role', '') != 'viewer') || isAdmin();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        // Phase-1.5: pin companyId to the caller's own tenant (claim or, for
        // solo operators, their uid). Stops a rep stamping a foreign tenant's
        // companyId onto a lead and polluting that tenant's company-scoped
        // rollups. Client always stamps `claims.companyId || uid`.
        && (request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);

      // D3: flat-path subcollections — the measurementWebhook +
      // esignWebhook auto-append activity here via admin SDK. Rules
      // only expose READ to the lead's owner + platform admin;
      // writes are admin-SDK only so webhook-stamped events can't
      // be forged by a rep.
      //
      // F-05: tightened. Reps can append manual notes/calls/sms/etc.
      // but can NOT fabricate webhook- or payment-shaped entries.
      // Every client-written activity must declare `source: 'rep'`
      // and restrict `type` to the human-action allowlist. Any
      // financial or webhook-scoped fields are disallowed on client
      // writes; those come only from admin SDK (webhooks).
      match /activity/{activityId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // Reps can append their own notes/activity via direct write; the
        // rule enforces shape. Webhook-written activities (measurement,
        // stripe, esign, calcom) bypass these rules via admin SDK.
        allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          && request.resource.data.source == 'rep'
          // F-05 allowlist of rep-authored, first-party activity types. These
          // are UI/timeline labels (drive timeline icons + lead-score signals)
          // — NOT webhook/payment-shaped — and remain gated by source=='rep',
          // the parent-lead owner check, and the financial-key denylist below.
          // ('voicemail','supplement_created','lead_created' added 2026-06-23:
          // these legit rep actions were silently permission-denied without it.)
          && request.resource.data.type in [
               'note', 'call', 'sms_out', 'email_out',
               'photo_added', 'task_done', 'appointment_set',
               'door_knock', 'follow_up', 'status_change',
               'voicemail', 'supplement_created', 'lead_created'
             ]
          && !(request.resource.data.keys().hasAny([
               'stripeInvoiceId', 'stripeCustomerId', 'stripePaymentIntentId',
               'amountCents', 'hostedInvoiceUrl',
               'signatureDocumentId', 'signatureProvider',
               'externalJobId', 'measurements', 'reportUrl'
             ]));
        allow update, delete: if false;
      }
      match /tasks/{taskId} {
        allow read:   if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write:  if isAuth()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }
      match /notes/{noteId} {
        allow read:   if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write:  if isAuth()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }

      // ── RECORDINGS (Voice Intelligence) ───────────────
      // C2 — written by the Storage-triggered pipeline
      // (functions/integrations/voice-intelligence.js) via admin
      // SDK; clients never write directly so shape forgery is
      // impossible (same pattern as F-05 activity rule).
      //
      // Reads: lead owner, platform admin, or a company manager
      // whose companyId matches the recording's stamped companyId.
      // The company-scope check lets team managers review their
      // reps' calls without cross-tenant leakage.
      //
      // Audio files live at audio/{uid}/{leadId}/{recordingId}.ext
      // in Storage (see storage.rules); the doc here is the
      // transcript + structured summary + metadata.
      match /recordings/{recordingId} {
        allow read: if isAuth() && (
          isAdmin()
          || isOwner(resource.data.userId)
          || (isManager()
              && resource.data.companyId != null
              && resource.data.companyId == myCompanyId())
        );
        allow write: if false;  // admin SDK only
      }

      // ── PORTAL MESSAGES (homeowner ↔ rep async chat) ──
      // Wave 123: bidirectional messaging surface. The homeowner
      // sends via the portal token-authed Cloud Function
      // (sendPortalMessage); the rep sends via a uid-authed callable
      // (replyToPortalMessage). Both write through admin SDK so
      // shape forgery is impossible — clients never write here.
      //
      // Reads: lead owner (rep) for the customer-page thread view,
      // or admin. Homeowner reads via getPortalMessages Cloud
      // Function with token auth (no Firebase user, so no rule
      // applies on that path — it goes through admin SDK).
      match /portal_messages/{messageId} {
        allow read: if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if false; // admin SDK only
      }

      // ── DOCUMENTS attached to a lead ──────────────────
      // Generated proposals/contracts/invoices/etc. that the rep
      // attaches to a customer record. Same auth shape as notes/tasks
      // — readable + writable by the lead owner (or admin). Without
      // this rule the Firestore default-deny silently hid every
      // attached document from the customer page documents list.
      match /documents/{documentId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if isAuth()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }

      // ── DRAWINGS (roof measurements, sketches) ────────
      // Persistent maps.js drawings keyed under the lead. Same
      // owner-or-admin auth pattern. Default-deny was hiding every
      // saved drawing on customer page reload.
      match /drawings/{drawingId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if isAuth()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }

      // ── AI TEXTING DRAFTS (T-2) ───────────────────────
      // generateAIDraft (incomingSMS webhook, admin SDK) writes a
      // suggested SMS reply here with status:'pending'. The rep's
      // customer-page panel reads them and flips status to 'approved'
      // (the onAiDraftApproved trigger then sends via Twilio) or
      // 'dismissed'. Owner-scoped via the draft's own stamped userId
      // (set from lead.userId at creation) — cheaper than a get() and
      // matches the recordings block's pattern.
      //
      // Rep updates are tightly constrained: they may only touch the
      // approve/dismiss/edit fields and may only move status to
      // 'approved' or 'dismissed'. They can NOT forge 'sent'/'failed'
      // (the trigger owns terminal states) nor mutate leadId/userId/
      // companyId/draftText-provenance/Twilio fields. create+delete are
      // admin-SDK only so a rep can't fabricate or destroy drafts.
      match /ai_drafts/{draftId} {
        allow read: if isAuth() && (isAdmin() || isOwner(resource.data.userId));
        allow update: if isAuth()
          && isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'draftText', 'approvedAt', 'approvedBy', 'editedByRep', 'dismissedAt'])
          && request.resource.data.status in ['approved', 'dismissed'];
        allow create, delete: if false; // admin SDK only
      }

      // ── SAVED SIGNATURES (PR3a — reuse store) ─────────
      // The doc generator writes each captured signature PNG here keyed
      // by role (Homeowner/Rep/Witness/…) after the customer signs, so a
      // future doc for the same lead can offer "Use saved" (PR3b). Same
      // owner-or-admin auth as documents/drawings — the rep owns their
      // lead's signature store; nobody else can read or write it.
      match /signatures/{sigRole} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if isAuth()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }
    }

    // Audit #23: the nested /leads/{uid}/leads/{leadId} rule was a leftover
    // from an earlier nested schema. The live app stores leads flat at
    // /leads/{leadId} (see rule above). Only archived code under
    // docs/pro/js/_archive/ still references the nested path, so this rule
    // was granting unused read/write surface area. Removed — flat rule above
    // is the canonical path.

    // ── ESTIMATES ─────────────────────────────────────
    match /estimates/{estimateId} {
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      // Edit-estimate legitimately rewrites the money fields (updateDoc with the
      // rebuilt payload), so DON'T freeze totals — but owner/provenance and the
      // server-stamped view counters must be immutable from the client (else an
      // owner could rewrite userId/createdBy or spoof viewCount/viewedAt to fake
      // engagement). The edit payload (_buildSavePayload) carries none of these
      // keys, so normal edits pass `didNotChange`. Mirrors the /expenses guard.
      allow update: if (isOwner(resource.data.userId)
            && didNotChange(['userId', 'createdBy', 'createdAt', 'viewedAt', 'viewCount', 'lastViewedAt', 'lastViewedVia']))
        || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── SUPPLEMENTS (insurance leverage tool) ─────────
    // Wave 144: opened by adding the supplement-builder UI on the
    // customer-page estimate row. Engine
    // (estimate-supplement.js) was complete but the collection
    // had no Firestore rule — every saveToFirestore() call
    // silently 403'd. Same owner-scope shape as estimates: a
    // supplement always has userId stamped by saveToFirestore;
    // reads + updates require owner; creates require the caller's
    // uid be on the new doc. Schema: { userId, leadId,
    // parentEstimateId, version, status, reason, addedItems[],
    // modifications[], createdAt, updatedAt }.
    match /supplements/{supplementId} {
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      // Freeze the provenance on this financial doc: a saved supplement can't be
      // re-owned or re-pointed to a different parent estimate. Supplements are
      // created append-only (addDoc, versioned), so a legit update keeps userId +
      // parentEstimateId stable → passes; only tampering trips the guard.
      allow update: if (isOwner(resource.data.userId)
            && didNotChange(['userId', 'parentEstimateId']))
        || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── EXPENSES (job costs / supplier spend) ─────────
    // Company-shared expense ledger that feeds per-job gross margin
    // (ProfitTracker.computeJobPL) and the supplier-spend reports.
    //
    // Ownership: an expense is created by a rep (userId == caller) and
    // stamped with the caller's tenant (companyId), pinned to the
    // caller's OWN company exactly like /leads — a rep can never write
    // an expense into a foreign tenant's rollups. Reads follow the
    // recordings/ + leaderboard precedent: the owning rep sees their
    // own; a company_admin or manager sees the whole team's spend (same
    // companyId — this is the "team admin sees all reps' spend" intent);
    // platform admin sees all. Updates/deletes stay with the owner
    // (non-viewer) or platform admin, and the immutable audit fields
    // (userId/companyId/createdAt/createdBy) can NEVER be mutated — IRS
    // "adequate records" (Rev. Proc. 97-22) want a stable provenance
    // trail and an un-rewritable original.
    //
    // Schema: { userId, companyId, leadId|null, category, costType
    //   ('direct'|'overhead'), supplier, amountCents (int), taxCents?
    //   (int), currency, date (Timestamp), note?, receiptStoragePath|null,
    //   receiptDocRef|null, source ('manual'|'ocr'), ocr?, needsReview,
    //   createdAt, createdBy, updatedAt }. The category→costType map and
    //   the single revenue basis live in docs/pro/js/expense-config.js
    //   (one source of truth shared by the form, reports, and margin
    //   engine — prevents the metric-definition drift that lets margins
    //   lie).
    //
    // Indexes (firestore.indexes.json, shipped in THIS change per the
    // rule-mismatch-audit discipline): {companyId,date}, {userId,date},
    // {userId,leadId,date}, {companyId,leadId,date}. A missing composite
    // index makes the spend report SILENTLY EMPTY — static CI catches
    // neither that nor a missing rule.
    match /expenses/{expenseId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyStaff()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      // .get('role','') NOT `.role != 'viewer'` — reading an ABSENT claim
      // key with != THROWS in rules (solo operators have no role claim),
      // which would permission-deny their own edits. Same fix as /leads.
      allow update: if (isOwner(resource.data.userId)
            && request.auth.token.get('role', '') != 'viewer'
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy']))
        || isAdmin();
      allow delete: if (isOwner(resource.data.userId)
            && request.auth.token.get('role', '') != 'viewer')
        || isAdmin();
    }

    // ── RECURRING EXPENSES (templates) ────────────────
    // One-tap-add templates for recurring costs (insurance, software, etc.).
    // Same owner + company-shared shape as /expenses. Generated occurrences are
    // normal /expenses docs; this just holds the template + nextDueDate.
    match /recurringExpenses/{templateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyStaff() && resource.data.companyId != null && resource.data.companyId == myCompanyId());
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId() || request.resource.data.companyId == request.auth.uid);
      allow update: if (isOwner(resource.data.userId) && request.auth.token.get('role', '') != 'viewer'
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy'])) || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && request.auth.token.get('role', '') != 'viewer') || isAdmin();
    }

    // ── SUPPLIERS / VENDORS (1099 tracking) ───────────
    // Vendor records for 1099 tracking. NO TIN/SSN is stored here (or anywhere,
    // yet — product decision). Firestore rules can't hide a field, so a TIN on
    // a readable doc would leak to every same-company reader; the create/update
    // rules below therefore HARD-REJECT any client write carrying tin/ssn/ein.
    // The suppliers/{id}/private/** subtree is a locked, server-only seam
    // reserved for a future admin-SDK-encrypted TIN — clients can't touch it.
    match /suppliers/{supplierId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyStaff() && resource.data.companyId != null && resource.data.companyId == myCompanyId());
      // ALLOWLIST (not a denylist): only these tracking fields may be written
      // from the client, so ANY tax-ID key variant (tin/ssn/ein/taxId/social/…)
      // is rejected, not just three spellings (QA finding). The full TIN lives
      // only in the locked private/** subtree (server-only), never here.
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId() || request.resource.data.companyId == request.auth.uid)
        && request.resource.data.keys().hasOnly(['userId', 'companyId', 'displayName', 'legalName',
             'taxClassification', 'is1099Eligible', 'w9Status', 'contact', 'createdAt', 'createdBy', 'updatedAt']);
      allow update: if (isOwner(resource.data.userId) && request.auth.token.get('role', '') != 'viewer'
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy'])
            && request.resource.data.keys().hasOnly(['userId', 'companyId', 'displayName', 'legalName',
                 'taxClassification', 'is1099Eligible', 'w9Status', 'contact', 'createdAt', 'createdBy', 'updatedAt'])) || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && request.auth.token.get('role', '') != 'viewer') || isAdmin();

      // Server-only seam for a future encrypted TIN — locked to ALL clients.
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // ── PHOTOS ────────────────────────────────────────
    match /photos/{photoId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── MAP PINS ──────────────────────────────────────
    match /pins/{pinId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── UNLINKED DRAWINGS (draw tool, no matching lead) ──
    // saveDrawingToCustomer (maps-routing.js) falls back to this
    // top-level collection (leadId '_unlinked_<uid>') when no lead
    // matches the drawn address; loadDrawingFromCustomer queries it
    // with where(userId == uid) + orderBy(version desc). It had NO
    // rule, so default-deny made every unlinked save AND load
    // permission-denied (NEW-D40a) — the lead-linked path already
    // works via leads/{leadId}/drawings above. Same owner-scope
    // shape as photos / pins.
    match /drawings/{drawingId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── TASKS ─────────────────────────────────────────
    match /tasks/{taskId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── COMMUNICATIONS (call / email / SMS log) ───────
    // Written from customer.html when a rep taps call / email / SMS
    // shortcut buttons. Owner scope by userId.
    match /communications/{commId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── NOTIFICATIONS ─────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      // Creation is server-side (admin SDK). Allow self-create too for client-initiated flows
      // but only if the userId matches the caller, to prevent cross-tenant spam.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── EMAILS (sent log) ─────────────────────────────
    // Ownership binds to the IMMUTABLE uid (sentByUid). The token email is a
    // mutable identity key, so it's kept only as a fallback for docs written
    // before sentByUid existed — new writes additionally bind to the uid.
    match /emails/{emailId} {
      allow read: if isAuth() && (
        resource.data.get('sentByUid', '') == request.auth.uid ||
        resource.data.sentBy == request.auth.token.email
      );
      allow create: if isAuth() &&
        request.resource.data.sentBy == request.auth.token.email &&
        (!('sentByUid' in request.resource.data) ||
         request.resource.data.sentByUid == request.auth.uid);
    }

    // ── DOCUMENTS ─────────────────────────────────────
    match /documents/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── NOTES ─────────────────────────────────────────
    match /notes/{noteId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── USER SETTINGS / PROFILE ───────────────────────
    // Profile is self-owned but privileged fields are locked to the server.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role','plan','accessCode','isAdmin','companyId']);
      allow update: if isOwner(uid)
        && didNotChange(['role','plan','accessCode','isAdmin','companyId']);
      allow delete: if isAdmin();

      match /{subcol}/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /userSettings/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── COMPANY PROFILE ──────────────────────────────────
    // Per-tenant config that drives the editable legal text / financing
    // tiers / marketing copy / code references baked into EVERY generated
    // document (contracts, estimates, invoices). Phase-1 audit fix: the
    // old `companyProfile/main` singleton with `allow read, write: if
    // isAuth()` let any authenticated user of ANY tenant read a tenant's
    // legal/financing config and OVERWRITE it — corrupting the terms in
    // every doc that tenant generates. Now keyed per tenant:
    //   - team members key by their companyId claim
    //   - solo operators key by uid (companyId == uid convention, same as
    //     requireTeamAdmin in functions/handlers/_shared.js). An owner's
    //     uid equals the companyId their invited members carry, so the
    //     whole tenant resolves to one doc while staying isolated from
    //     other tenants.
    // The legacy `companyProfile/main` doc is migrated to the per-tenant
    // key by functions/migrate-companyprofile-per-tenant.js and is no
    // longer client-reachable (its id matches neither branch below).
    match /companyProfile/{companyId} {
      // Same-tenant members (any role) may read AND write their own company's
      // profile; cross-tenant is denied by the companyId/uid scoping. NOTE: a
      // 2026-06-24 audit flagged that this lets a viewer/sales_rep edit the
      // legal/financing text — but the cross-tenant rules test deliberately
      // asserts a same-tenant sales_rep CAN write own config (it encodes the
      // desired behaviour), so role-restricting writes is a PRODUCT decision,
      // not a security fix. Left open per that tested design intent.
      allow read, write: if isAuth()
        && (companyId == myCompanyId() || companyId == request.auth.uid);
    }

    // ── SUBSCRIPTIONS ─────────────────────────────────
    // READ-ONLY for the owner. All writes go through the Stripe webhook or
    // the hardened validateAccessCode Cloud Function (admin SDK).
    match /subscriptions/{uid} {
      // Pillar 4: billing is company-level. The doc is keyed by the OWNER's
      // uid (== the companyId their team carries), so same-company members
      // may READ their company's plan — billing-gate and the dashboard
      // resolve limits from subscriptions/{companyId || uid}. Cross-tenant
      // stays denied (myCompanyId() never equals another owner's uid).
      allow read: if isOwner(uid) || isAdmin()
        || (isAuth() && myCompanyId() == uid);
      allow write: if false;
    }

    // ── ACCESS CODES ──────────────────────────────────
    // Admin-SDK-only. Clients can neither read nor write.
    match /access_codes/{codeId} {
      allow read, write: if false;
    }

    // ── LEADERBOARD ───────────────────────────────────
    // Readable within the same company (or admin/owner). Writes are
    // admin-SDK only — counters must come from a Cloud Function that
    // aggregates authoritative data, never from the client. This
    // prevents trivial inflation of closedDeals/revenue from the rep's
    // own session.
    match /leaderboard/{uid} {
      allow read: if isAdmin()
        || isOwner(uid)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      allow write: if false;
    }

    // ── COUNTERS (atomic ID sequences) ────────────────
    // Used by dashboard.html + customer.html runTransaction calls to mint
    // sequential customer IDs (NBD-####). `customerIds` is the only counter.
    // Phase-1.5 audit (#1.2): writes are now MONOTONIC — create at 1, update
    // by exactly +1 — so a tenant can no longer overwrite/garble another
    // tenant's ID sequence (e.g. set it to 999999). Read stays open because
    // the client mint transaction must read the current value to compute
    // next+1. Residual (accepted P3): the read still leaks the count, and an
    // authed user could advance the counter via repeated +1s — true
    // per-tenant isolation = a per-company ID scheme + server-side
    // allocation, a separate product decision.
    match /counters/{counterId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.next == 1;
      allow update: if isAuth()
        && request.resource.data.next is int
        && request.resource.data.next == resource.data.next + 1;
    }

    // ── API USAGE LOGGING ─────────────────────────────
    // Writes happen via admin SDK (Cloud Function). Reads: own usage or admin.
    match /api_usage/{docId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── API USAGE DAILY COUNTERS (admin-SDK only) ─────
    // M2: materialized per-(day, uid) and per-(day, company) token
    // counters that replace the N-doc range scan on the claudeProxy
    // hot path. Clients see budget headroom only via the 429
    // response — direct reads would be an information-leak surface
    // AND an abuse vector (a client that can read the counter could
    // time-probe it for competitor intel).
    match /api_usage_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── RATE LIMITS (admin-SDK only) ──────────────────
    match /rate_limits/{uid}        { allow read, write: if false; }
    match /_rate_limits_ip/{docId}  { allow read, write: if false; }

    // ── PHOTO VISION COST METERS (admin-SDK writes) ──
    // Owner can read their own meters so the client knows when caps
    // are approaching ("$8.40 of $10 used on this lead"). Writes are
    // funnel-locked: only analyzePhotoVision (admin SDK) increments.
    match /leadCostMeter/{leadId} {
      allow read: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /userCostMeter/{docId} {
      // Doc id is "{uid}__{YYYY-MM}". Owner can read any of their
      // months. Useful for "you've used $32/$50 this month" UI.
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Vision response cache (admin-SDK only — sha256(imageUrl) → suggestion).
    // Clients never touch this directly; the function reads/writes.
    match /visionCache/{cacheKey} {
      allow read, write: if false;
    }

    // ── CUSTOMER AUDIT EVENTS (Batch 7) ──────────────────
    // Server-stamped log of what the homeowner did on the portal —
    // portal_open, photo_view, estimate_view, etc. The rep reads them
    // on customer.html; writes are admin-SDK-only (recordCustomerEvent
    // validates the portal token before writing).
    match /customerAuditEvents/{eventId} {
      allow read:  if isOwner(resource.data.ownerUid) || isAdmin();
      allow write: if false;
    }

    // ── DAILY SUCCESS ─────────────────────────────────
    match /daily_entries/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── DAILY TRACKER ────────────────────────────────
    match /dailyTracker/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── D2D KNOCKS ────────────────────────────────────
    match /knocks/{knockId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isManager() && sameCompanyAsResource());
      // Phase-1.5: companyId, if present, must be the caller's own tenant —
      // a rep can't tag a knock with another company's id (which would make
      // it readable by that company's managers). Presence not required so a
      // missed client path degrades to owner-only, never cross-tenant.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── REPS (team member profiles) ──────────────────
    // Reads scoped to same company or admin. Never globally enumerable.
    match /reps/{repId} {
      allow read: if isAdmin()
        || isOwner(repId)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      allow create: if isOwner(repId)
        && !request.resource.data.keys().hasAny(['role','isAdmin'])
        // Phase-1.5: companyId, if present, must be the caller's own tenant.
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      allow update: if (isOwner(repId) && didNotChange(['role','isAdmin','companyId']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── TERRITORIES ──────────────────────────────────
    match /territories/{territoryId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      // Phase-1.5: companyId, if present, must be the caller's own tenant.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── PRODUCTS ──────────────────────────────────────
    match /products/{productId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── ML TRAINING DATA (roof edge detection) ────────
    // Audit A: maps.js draw flow writes labeled training pairs (auto-
    // detected polygon + user-corrected polygon) here. Previously had
    // NO rule so default-deny silently 403'd every save — every
    // training pair was lost. Same owner-scope pattern as photos /
    // pins: userId on the doc, create requires self-stamp, read locked
    // to owner + platform admin (training-data is sensitive aerial
    // imagery metadata; should never leak cross-tenant).
    match /ml_training_data/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();  // training data is append-only from the rep's perspective
    }

    // ── TEMPLATES ─────────────────────────────────────
    match /templates/{templateId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── COMPANIES ─────────────────────────────────────
    match /companies/{companyId} {
      // Readable by members of that company, the owner, or admin.
      allow read: if isAdmin()
        || (isAuth() && resource.data.ownerId == request.auth.uid)
        || (isAuth() && myCompanyId() == companyId);
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if (isAuth() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // Members subcollection is writable only by the company owner or admin.
      // QA 2026-06-21 #10: the live app queries /companies/{_user.uid}/members,
      // so companyId == the caller's own uid. The ownerId-doc check below FAILS
      // for solo owners who never had a /companies/{uid} doc created (get() of a
      // missing doc denies), so loadTeamMembers/invite were PERMISSION_DENIED.
      // Allow the company-keyed-by-uid owner directly — they can only ever reach
      // the members subcollection under their OWN uid, so this is tenant-safe.
      match /members/{memberId} {
        allow read: if isAdmin()
          || (isAuth() && request.auth.uid == companyId)
          || (isAuth() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid)
          || (isAuth() && request.auth.uid == memberId);
        // CREATE/UPDATE/DELETE are all server-mediated now — clients never
        // write member docs:
        //   - create → createTeamInvite (Pillar 4: enforces plan seat limits)
        //   - update → deactivateUser (disable/enable + status)
        //   - delete → removeMember (strips the member's companyId/role claims
        //     and revokes tokens BEFORE deleting; a bare client deleteDoc left
        //     a removed user with a live companyId claim and full tenant access,
        //     since Firestore authorizes by claim, not roster membership).
        // Admin-SDK callables bypass rules; platform admins keep client access.
        allow create, update, delete: if isAdmin();
      }
    }

    // ── TRAINING SESSIONS ────────────────────────────
    match /training_sessions/{sessionId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isManager() && sameCompanyAsResource());
      // Phase-1.5: companyId, if present, must be the caller's own tenant.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── REAL DEAL ACADEMY ────────────────────────────
    // Per-user training progress. Doc id IS the owner's uid; the live app
    // reads/writes /academy_progress/{uid} (real-deal-academy.js _loadProgress
    // / _saveProgress). No rule existed, so every read/write was
    // PERMISSION_DENIED and the Academy silently fell back to localStorage
    // (progress never synced server-side / cross-device). QA 2026-06-21 #2.
    match /academy_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── ETERNAL VAULT / PROJECT CODEX ────────────────
    // Jo's personal build-memory tool (docs/pro/js/vault-page.js):
    //   codex/latest         → the full codex snapshot (setDoc)
    //   codex-sessions/{id}   → per-session deltas (e.g. s01-delta)
    // This is a singleton DEV artifact — not tenant data, not per-user
    // owned: the docs carry no userId/companyId field. With no rule they
    // default-deny, so the Vault's "Save to Firestore" silently
    // PERMISSION_DENIED and never synced. Lock to the platform admin OR
    // Jo's uid (the sole operator of this tool). QA 2026-06-21.
    match /codex/{docId} {
      allow read, write: if isAdmin()
        || (isAuth() && request.auth.uid == '1phDvAVXHSg82wDLegAbQFq14Ci1');
    }
    match /codex-sessions/{sessionId} {
      allow read, write: if isAdmin()
        || (isAuth() && request.auth.uid == '1phDvAVXHSg82wDLegAbQFq14Ci1');
    }

    // ── PUBLIC LEAD FORMS ────────────────────────────
    // Direct client creates are DISABLED (C-3). Public forms must now
    // post through the `submitPublicLead` Cloud Function, which enforces
    // App Check + per-IP rate limit + honeypot + origin allowlist before
    // writing here via the admin SDK. Rules can't rate-limit, so direct
    // creates are an unbounded spam/billing DoS vector.
    match /guide_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /contact_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /estimate_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /storm_alert_subscribers/{subId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // ── STORM ALERTS SENT LOG (Cloud Function only) ──
    match /storm_alerts_sent/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── OTP / VERIFIED PHONES (admin-SDK only) ───────
    match /otp_requests/{docId}    { allow read, write: if false; }
    match /verified_phones/{phone} { allow read, write: if false; }
    match /unmatched_sms/{docId}   { allow read: if isAdmin(); allow write: if false; }

    // ── INVOICES ─────────────────────────────────────
    // Was createdBy-only with no viewer guard: a team manager couldn't read
    // team invoices, and a viewer-role user could mutate/delete them. Mirrors
    // the /expenses tenancy pattern — company-scoped read, companyId required on
    // create, viewer blocked from writes, provenance frozen.
    match /invoices/{invoiceId} {
      allow read: if isOwner(resource.data.createdBy)
        || isAdmin()
        || (isCompanyStaff()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      // .get('role','') — reading an absent claim with != THROWS (solo owners
      // have no role claim). Freeze owner/tenant/provenance; money fields stay
      // mutable (markPaid rewrites balanceDue/amountPaid/status).
      allow update: if (isOwner(resource.data.createdBy)
            && request.auth.token.get('role', '') != 'viewer'
            && didNotChange(['createdBy', 'companyId', 'estimateId', 'createdAt']))
        || isAdmin();
      allow delete: if (isOwner(resource.data.createdBy)
            && request.auth.token.get('role', '') != 'viewer')
        || isAdmin();
    }

    // ── EMAIL DRIP ───────────────────────────────────
    match /drip_queue/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /drip_log/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // ── EMAIL / SMS LOG (admin-SDK write, owner read) ─
    match /email_log/{docId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false;
    }
    match /sms_log/{docId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false;
    }

    // ── LEAD DOCUMENTS ───────────────────────────────
    match /lead_documents/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── REFERRALS ────────────────────────────────────
    match /referrals/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── REVIEW REQUESTS ──────────────────────────────
    match /review_requests/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── REPORTS ──────────────────────────────────────
    match /reports/{docId} {
      // Team visibility: a report carries the creator's companyId (stamped by
      // saveReport). Same-company members can read it so teammates/managers see
      // each other's inspection reports on shared leads — this also lets the
      // unfiltered per-lead query (where leadId == X) succeed for colleagues.
      // sameCompanyAsResource() requires BOTH companyIds non-null, so a solo
      // user (no companyId claim) or a legacy report (no companyId field) still
      // falls back to owner-only via isOwner — no cross-tenant leak.
      allow read: if isOwner(resource.data.userId) || isAdmin() || sameCompanyAsResource();
      // Pin companyId on create (mirrors /leads, /expenses, /invoices). Without
      // this a crafted write could set ANY companyId and inject a report into
      // another tenant's team-visible feed (sameCompanyAsResource read) — and
      // report.html renders same-origin, so that was a cross-tenant stored-XSS
      // vector. saveReport already stamps companyId = claims.companyId || uid.
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || request.resource.data.companyId == request.auth.uid);
      allow update: if isAdmin();
      // Owners must be able to delete their own saved reports — the My
      // Reports list exposes a delete button to every owner, and admin-only
      // delete left it permanently failing (NEW-D11).
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── INVITES (admin-SDK only) ─────────────────────
    match /invites/{token} { allow read, write: if false; }

    // ── AUDIT LOG (admin-only reads, admin-SDK writes) ─
    match /audit_log/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── PORTAL TOKENS (admin-SDK only) ─────────────────
    // Minted by createPortalToken, consumed by getHomeownerPortalView.
    // Tokens are sensitive — a leaked token grants read of a
    // homeowner's redacted project view, so clients get no direct
    // access. The homeowner-facing page talks to the HTTP endpoint.
    match /portal_tokens/{token} {
      allow read, write: if false;
    }

    // ── REMOTE-SIGNING TOKENS (admin-SDK only) ─────────
    // Signatures PR4/5. createSignRequest mints these; the homeowner
    // signs via the public getSignDocument / submitSignature endpoints
    // (token-authed, admin SDK). No Firebase-auth client ever touches
    // this collection — same lockdown as portal_tokens.
    match /doc_sign_tokens/{token} {
      allow read, write: if false;
    }

    // ── CLOSE BOARD DEAL ROOMS ────────────────────────
    // Shareable deal rooms (close-board.js syncDealToFirestore). Owner-keyed on
    // userId. createDealAcceptToken (admin SDK) reads this doc to owner-scope a
    // share token + snapshot tier prices, so userId MUST be trustworthy: pin it
    // to the caller on create (a rep can't plant a deal under another uid).
    // Without this rule the client write default-denied and deals never synced.
    match /deal_rooms/{dealId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // Close Board deal acceptance (1a). createDealAcceptToken mints these;
    // the homeowner accepts via the public getDealRoom / submitDealAcceptance
    // endpoints (token-authed, admin SDK). No Firebase-auth client ever
    // touches this collection — same lockdown as doc_sign_tokens.
    match /deal_accept_tokens/{token} {
      allow read, write: if false;
    }

    // Inspection report sharing. createReportShareToken mints these; the
    // homeowner views the report via the public getSharedReport endpoint
    // (token-authed, admin SDK reads the report HTML inline). No Firebase-auth
    // client ever touches this collection — same lockdown as deal_accept_tokens.
    match /report_share_tokens/{token} {
      allow read, write: if false;
    }

    // ── PARCEL CACHE (admin-SDK only) ──────────────────
    // Regrid lookup cache — reads are a privacy issue (address →
    // owner name). Only the Cloud Function accesses via admin SDK.
    match /parcel_cache/{key} {
      allow read, write: if false;
    }

    // ── MEASUREMENTS (rep owner-scoped) ────────────────
    // Created by requestMeasurement, filled by measurementWebhook.
    // Owner can read to pre-fill the V2 Builder; writes are admin-
    // SDK only (webhook).
    match /measurements/{jobId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow write: if false;
    }

    // ── APPOINTMENTS (Cal.com webhook output) ──────────
    // Written by calcomWebhook, read by the owning rep.
    match /appointments/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // ── ACCOUNT ERASURE REQUESTS (admin-SDK only) ──────
    // D7: two-step GDPR erasure. The token hash never leaves the
    // server, so the only way to confirm a deletion is through
    // the confirmAccountErasure HTTP endpoint (which validates the
    // emailed token against the hash).
    match /account_erasures/{uid} {
      allow read, write: if false;
    }

    // ── EMAIL QUEUE (admin-SDK only) ───────────────────
    // Enqueued by server-side flows (GDPR confirmations, dunning,
    // portal invites). A worker processes + clears entries. Clients
    // should never touch this — they'd be able to spoof senders or
    // mine the queue for email addresses.
    match /email_queue/{id} {
      allow read, write: if false;
    }

    // ── DEVICE FINGERPRINTS (admin-SDK only) ───────────
    // D9: per-uid list of seen device fingerprints, used by the
    // new-device Slack alert. Writes only via server triggers.
    match /user_devices/{uid} {
      allow read, write: if false;
      match /seen/{fingerprint} {
        allow read, write: if false;
      }
    }

    // ── FEATURE FLAGS (read by any authed user) ────────
    // F9: _default holds the platform defaults. {uid} is an
    // optional per-user override. Platform admin only writes.
    match /feature_flags/_default {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /feature_flags/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── V2 ESTIMATE DRAFTS (owner only) ────────────────
    // F7: one draft doc per user keyed by uid. Owner reads/writes
    // their own; everyone else (including platform admin) is blocked
    // because drafts are ephemeral + the finalized estimate survives
    // in `estimates/`.
    match /estimate_drafts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── SMS OPT-OUT LIST (admin-SDK only) ──────────────
    // F3: TCPA compliance. incomingSMS (Twilio webhook) writes here
    // when a recipient replies STOP. sendSMS + sendD2DSMS read it
    // before sending. Both paths go through the admin SDK; clients
    // never need direct access, and leaking the list would identify
    // every number that opted out.
    match /sms_opt_outs/{phone} {
      allow read, write: if false;
    }

    // Entries for the annual "One Free Roof" giveaway. Written only by
    // the submitPublicLead Cloud Function via admin SDK; NBD staff
    // triages entries through the Firebase console (server-side) so no
    // client read surface is needed.
    match /free_roof_entries/{id} {
      allow read, write: if false;
    }

    // Public cache doc for /api/google-reviews. Written by the Cloud
    // Function with admin SDK; clients fetch the function endpoint,
    // never the doc directly.
    match /public_cache/{key} {
      allow read, write: if false;
    }

    // ── STRIPE WEBHOOK IDEMPOTENCY (admin-SDK only) ──
    // F-07 + invoiceWebhook idempotency: stripe.js atomic-creates a
    // doc here keyed by event.id to block duplicate deliveries. The
    // admin SDK bypasses rules; clients never need to touch this.
    // An explicit rule (vs. falling through to default-deny) makes
    // the intent clear for future readers.
    // ── MIGRATION FRAMEWORK STATE (admin-SDK only) ──────
    // /system/migrations holds appliedVersion + lastError for the
    // versioned runner in functions/migrations/runner.js. Clients
    // never need to read or write this — admin scripts and the
    // scheduled tick are the only legitimate writers.
    match /system/{docId} {
      allow read, write: if false;
    }
    match /system/migrations/history/{historyId} {
      allow read, write: if false;
    }

    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // Tenant microsite slug claim docs (Pillar 5). Admin-SDK only — written
    // transactionally by setSiteSlug as the uniqueness lock + reverse index;
    // clients never read or write them (getPublicSiteConfig reads server-side).
    match /siteSlugs/{slug} {
      allow read, write: if false;
    }

    // ── DEFAULT DENY ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
