rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// NBD MARKETING SITE — Firestore Rules — HARDENED (2026-04-11)
//
// Project: `nobigdealwithjoedeal`
//   apiKey: AIzaSyDmDhacGOipy1JRfprrFcEBqKLfUZ8meYQ
//
// Scope: this file ONLY covers the marketing project. The NBD Pro SaaS app
// lives in the `nobigdeal-pro` project and uses /firestore.rules at the
// repo root.
//
// HOW TO DEPLOY:
//   1. Clone/check out this file into the marketing-site Firebase project
//      directory (or use `firebase deploy --only firestore:rules --project
//      nobigdealwithjoedeal` from a directory configured for that project).
//   2. Run `firebase deploy --only firestore:rules` against the marketing
//      project.
//
// The marketing site only needs ONE public-write collection: `leads`
// (from the homepage/oaks/template contact forms). Everything else is
// denied by default.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── LEADS (marketing funnel — CLOSED to client writes) ─────
    // Direct client creates are disabled. Public lead intake from the
    // marketing/microsite forms now flows through the hardened
    // `submitPublicLead` Cloud Function on nobigdeal-pro (App Check +
    // Turnstile + per-IP rate limit + honeypot), which writes server-side
    // via the Admin SDK and bridges the lead into the CRM. This collection
    // previously accepted UNAUTHENTICATED public creates gated only by shape
    // checks — no App Check (never registered for this project), no rate
    // limit — so anyone could POST unlimited leads straight to Firestore.
    // See docs/sites/js/marketing-firebase.js for the client migration.
    match /leads/{leadId} {
      allow read, create, update, delete: if false;
    }

    // ── DEFAULT DENY ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
