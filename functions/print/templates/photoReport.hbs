{{!--
  PHOTO REPORT — D-4 / D-6 report builder
  ──────────────────────────────────────────────────────────────────
  D-4 shipped this as a fixed document: a cover, three stat cards, an
  optional pairs section, and exactly three phase galleries in a fixed
  order, with every heading, blurb and cover line a hardcoded literal.
  The rep's only choice was homeowner vs adjuster.

  D-6 makes the document a function of `opts` + `sections`. The section
  list is ORDERED and ARBITRARY — the caller decides which sections
  exist, what they are called, what note sits under each heading, and
  which photos are in them. before/during/after still work as a legacy
  fallback (see §LEGACY) so any caller that has not migrated keeps
  rendering exactly as it did.

  ── Payload ───────────────────────────────────────────────────────
  opts {
    cover      'hero' | 'minimal' | 'none'
    density    'comfortable' | 'compact' | 'evidence'   (body class)
    columns    0 (auto) | 1 | 2 | 3 | 4
    fit        'cover' | 'contain'
    numbering  'continuous' | 'section' | 'none'
    numberLabel  e.g. 'Photo'  (prefix on each tile's number chip)
    showToc, showStats, showPairs                       booleans
    showDate, showLocation, showDamage, showSeverity    booleans
    signature  'none' | 'homeowner' | 'adjuster' | 'both'
  }
  notes { coverLetter, summaryBody, closing }   — rep-authored prose
  sections[] { id, title, blurb, note, photos[] }
  photos[]   { url, n, caption, location, damageType, severity, dateLabel }
             `n` is precomputed by the caller so numbering stays one
             decision made in one place, not re-derived per section here.
  toc[]      { title, count, note }
  meta[]     { label, value }   — property/claim key-value grid

  Everything below degrades: an absent `opts` renders the D-4 document.
--}}

{{!-- ─────────── 1. COVER ─────────── --}}
{{#unless (eq opts.cover "none")}}
{{!-- cover 'minimal' is this same page without the hero image; the caller
     blanks coverPhoto for it rather than the template branching, so the
     decision lives in one place. --}}
{{> coverPage
  eyebrow=coverEyebrow
  tagline=coverTagline
  sub=coverSub
  heroPhoto=coverPhoto
  heroCaption=coverCaption
  preparedFor=preparedFor
  preparedBy=preparedBy
  projectMeta=projectMeta
}}
{{/unless}}

{{!-- ─────────── 2. COVER LETTER (rep-authored) ─────────── --}}
{{#if notes.coverLetter}}
<section class="page-break">
  <div class="eyebrow">A note from {{#if preparedBy.name}}{{preparedBy.name}}{{else}}{{company.footerName}}{{/if}}</div>
  <div class="pr-letter">{{{nl2br notes.coverLetter}}}</div>
</section>
{{/if}}

{{!-- ─────────── 3. PROPERTY / CLAIM DETAIL ─────────── --}}
{{#if meta.length}}
<section class="{{#unless notes.coverLetter}}page-break{{/unless}} avoid-break">
  <h2 class="keep-with-next">Property &amp; Project</h2>
  <div class="kv-grid">
    {{#each meta}}
    <div class="kv">
      <div class="kv-label">{{this.label}}</div>
      <div class="kv-value">{{this.value}}</div>
    </div>
    {{/each}}
  </div>
</section>
{{/if}}

{{!-- ─────────── 4. SUMMARY + STATS ─────────── --}}
<section class="{{#unless meta.length}}{{#unless notes.coverLetter}}page-break{{/unless}}{{/unless}}">
  <div class="hero" style="margin-bottom: var(--s-5);">
    <div class="hero-eyebrow eyebrow">At a Glance</div>
    <div class="hero-title" style="font-size:30pt;">{{summary.headline}}</div>
    {{#if notes.summaryBody}}
      <div class="hero-sub pr-prose">{{{nl2br notes.summaryBody}}}</div>
    {{else}}
      {{#if summary.body}}<p class="hero-sub">{{summary.body}}</p>{{/if}}
    {{/if}}
  </div>

  {{#if stats}}{{#unless (eq opts.showStats false)}}
  <div class="stat-grid">
    {{#each stats}}
    <div class="stat">
      <div class="stat-label">{{this.label}}</div>
      <div class="stat-value">{{this.value}}</div>
      {{#if this.sub}}<div class="stat-sub">{{this.sub}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/unless}}{{/if}}
</section>

{{!-- ─────────── 5. CONTENTS ─────────── --}}
{{#if opts.showToc}}{{#if toc.length}}
<section class="avoid-break" style="margin-top: var(--s-6);">
  <h2 class="keep-with-next">Contents</h2>
  <div class="pr-toc">
    {{#each toc}}
    <div class="pr-toc-row">
      <span class="pr-toc-title">{{this.title}}</span>
      <span class="pr-toc-dots" aria-hidden="true"></span>
      <span class="pr-toc-count">{{this.count}} photo{{#unless (eq this.count 1)}}s{{/unless}}</span>
    </div>
    {{#if this.note}}<div class="pr-toc-note">{{this.note}}</div>{{/if}}
    {{/each}}
  </div>
</section>
{{/if}}{{/if}}

{{!-- ─────────── 6. BEFORE & AFTER PAIRS ─────────── --}}
{{#if pairs.length}}{{#unless (eq opts.showPairs false)}}
<section class="page-break ba-pair-section">
  <h2 class="keep-with-next">Before &amp; After</h2>
  <p class="meta" style="margin-bottom: var(--s-4);">Side-by-side comparisons of the same locations at start and finish.</p>
  {{#each pairs}}
  <div class="ba-pair">
    <div class="ba-cell">
      <div class="ba-frame">
        <img src="{{this.before.url}}" alt="Before — {{this.location}}">
        <div class="ba-stamp">Before</div>
      </div>
    </div>
    <div class="ba-cell">
      <div class="ba-frame">
        <img src="{{this.after.url}}" alt="After — {{this.location}}">
        <div class="ba-stamp after">After</div>
      </div>
    </div>
    <div class="ba-loc" style="grid-column: 1 / -1;">
      <strong>{{this.location}}</strong>
      <span>Pair {{inc @index}} of {{len ../pairs}}</span>
    </div>
    {{#if this.caption}}<div class="pr-pair-caption" style="grid-column: 1 / -1;">{{this.caption}}</div>{{/if}}
  </div>
  {{/each}}
</section>
{{/unless}}{{/if}}

{{!-- ─────────── 7. SECTIONS ─────────── --}}
{{#each sections}}
{{#if this.photos.length}}
<section class="page-break">
  <h2 class="keep-with-next">{{this.title}}</h2>
  {{#if this.blurb}}<p class="meta" style="margin-bottom: var(--s-4);">{{this.blurb}}</p>{{/if}}
  {{#if this.note}}
    {{!-- Rep-authored commentary for this section. Distinct from `blurb`,
         which is the template's own descriptive line. --}}
    <div class="pr-note pr-prose">{{{nl2br this.note}}}</div>
  {{/if}}
  <div class="photo-grid{{gridClass ../opts this.photos}}">
    {{#each this.photos}}
    <div class="photo-cell">
      <div class="photo-frame">
        <img src="{{this.url}}" alt="{{#if this.caption}}{{this.caption}}{{else}}{{this.location}}{{/if}}">
        {{#if this.n}}{{#unless (eq ../../opts.numbering "none")}}
          <div class="pr-num">{{#if ../../opts.numberLabel}}{{../../opts.numberLabel}} {{/if}}{{this.n}}</div>
        {{/unless}}{{/if}}
        {{#if this.location}}{{#unless (eq ../../opts.showLocation false)}}
          <div class="photo-tag">{{this.location}}</div>
        {{/unless}}{{/if}}
      </div>
      <div class="photo-meta">
        <div class="photo-caption">
          {{#unless (eq ../../opts.showDamage false)}}
            {{#if this.damageType}}<strong>{{this.damageType}}</strong>{{#if this.caption}} · {{/if}}{{/if}}
          {{/unless}}{{this.caption}}
        </div>
        <div class="pr-tile-foot">
          {{#if this.severity}}{{#unless (eq ../../opts.showSeverity false)}}
            <span class="sev {{severityClass this.severity}}" style="font-size:7pt;padding:1pt 5pt;">{{this.severity}}</span>
          {{/unless}}{{/if}}
          {{#if this.dateLabel}}{{#if ../../opts.showDate}}
            <span class="pr-date">{{this.dateLabel}}</span>
          {{/if}}{{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</section>
{{/if}}
{{/each}}

{{!-- ─────────── §LEGACY: before / during / after ───────────
     Rendered only when the caller populates `legacyPhases` INSTEAD of
     `sections` — the two are mutually exclusive by construction, so this is
     gated on presence rather than on `{{#unless sections}}`, which would also
     fire for a caller that deliberately sent an empty section list.
     Byte-for-byte the D-4 markup, so an unmigrated caller's PDF is unchanged. --}}
{{#each legacyPhases}}
{{#if this.photos.length}}
<section class="page-break">
  <h2 class="keep-with-next">{{this.title}}</h2>
  <p class="meta" style="margin-bottom: var(--s-4);">{{this.blurb}}</p>
  <div class="photo-grid{{#if (gt (len this.photos) 6)}} three{{/if}}">
    {{#each this.photos}}
    <div class="photo-cell">
      <div class="photo-frame">
        <img src="{{this.url}}" alt="">
        {{#if this.location}}<div class="photo-tag">{{this.location}}</div>{{/if}}
      </div>
      <div class="photo-meta">
        <div class="photo-caption">
          {{#if (eq ../../mode "adjuster")}}
            {{#if this.damageType}}<strong>{{this.damageType}}</strong> · {{/if}}{{this.caption}}
          {{else}}
            {{this.caption}}
          {{/if}}
        </div>
        {{#if this.severity}}<div class="photo-loc"><span class="sev {{severityClass this.severity}}" style="font-size:7pt;padding:1pt 5pt;">{{this.severity}}</span></div>{{/if}}
      </div>
    </div>
    {{/each}}
  </div>
</section>
{{/if}}
{{/each}}

{{!-- ─────────── 8. CLOSING NOTE ─────────── --}}
{{#if notes.closing}}
<section class="avoid-break" style="margin-top: var(--s-6);">
  <h2 class="keep-with-next">In Closing</h2>
  <div class="pr-prose">{{{nl2br notes.closing}}}</div>
</section>
{{/if}}

{{!-- ─────────── 9. ATTESTATION + SIGN-OFF ─────────── --}}
{{#if (signOff opts mode "adjuster")}}
<section class="avoid-break" style="margin-top: var(--s-6);">
  <h2>Documentation Attestation</h2>
  {{!-- The D-4 wording asserted every image was "unmodified except for
       standard format conversion and EXIF preservation". That was not true:
       the photo editor bakes drawn markup into the saved file, and the
       variants pipeline re-encodes to WebP. An attestation on a document a
       carrier may rely on has to describe what actually happened, and say
       plainly when a frame carries annotation. --}}
  <p style="line-height:1.65;">The photographs in this report were captured at the property described above by {{company.footerName}} personnel. Images are reproduced from the originals, resized and re-encoded for printing. {{#if hasAnnotated}}Frames marked <strong>Annotated</strong> carry measurement or callout markup added by the inspector; {{/if}}unmodified original files are available on request.</p>
</section>
{{/if}}

{{#if (signOff opts mode "adjuster")}}
<div class="sig-block">
  <div class="sig-grid">
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">{{preparedBy.name}} · {{company.footerName}}</div>
    </div>
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">Adjuster Acknowledgment &amp; Date</div>
    </div>
  </div>
</div>
{{/if}}

{{#if (signOff opts mode "homeowner")}}
{{!-- D-4 gave the homeowner report no acceptance line at all, so a rep who
     wanted a signed walkthrough had nothing to hand over. --}}
<div class="sig-block">
  <div class="sig-grid">
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">{{preparedFor.name}} · Homeowner</div>
    </div>
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">Date</div>
    </div>
  </div>
</div>
{{/if}}
