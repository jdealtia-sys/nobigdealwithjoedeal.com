<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture sitemap for the SKIP_DIRS carve-out in check-seo-surface.js.
     Mirrors the shape of docs/sitemap-pro.xml: a handful of public pages
     that live inside a directory the walk is told to skip. Every <loc> here
     exercises one branch of sitemapSurfaces(). -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- S1: directory form — /pro is served by pro/index.html. Deliberately
       carries unparseable JSON-LD, the defect the real gap let through. -->
  <url><loc>https://example.com/pro</loc></url>
  <!-- S2: flat form — /pro/pricing is served by pro/pricing.html. Carries a
       different defect (no h1) so the two resolution forms are told apart. -->
  <url><loc>https://example.com/pro/pricing</loc></url>
  <!-- S4: listed but no page ships for it, and no hosting rule serves it. -->
  <url><loc>https://example.com/pro/ghost</loc></url>
  <!-- S5: listed AND declares noindex — contradictory signals. -->
  <url><loc>https://example.com/pro/hidden</loc></url>
  <!-- S6: outside every skipped directory; the walk already has it, so it
       must not be added a second time. -->
  <url><loc>https://example.com/clean</loc></url>
  <!-- S8: no file on disk, but firebase.json 301s it. Served, not orphaned. -->
  <url><loc>https://example.com/pro/moved</loc></url>
  <!-- S9: no file on disk, but a globbed rewrite sends it to a function.
       Served, not orphaned. -->
  <url><loc>https://example.com/pro/fn-erasure</loc></url>
  <!-- S10: not an absolute URL, so no crawler can resolve it either. Nothing
       else owns this case — sitemap-pro.xml is hand-maintained and
       build-sitemap.js neither writes nor validates it. -->
  <url><loc>/pro/relative-oops</loc></url>
  <!-- S4 (second half): missing AND outside every skipped directory. The
       SKIP_DIRS filter must drop it before the orphan check — pages the walk
       owns are not this function's business. Without that filter this becomes
       a second orphan and S4's count assertion reddens, which is what makes
       the filter independently load-bearing rather than masked by the
       downstream Set. -->
  <url><loc>https://example.com/gone-outside-skip</loc></url>
</urlset>
